---
import styles from '../styles.css?url';
import contact from '../../content/contact.json';
const {title,body,page,description}=Astro.props;
const route=Astro.url.pathname;
const canonical=new URL(route,'https://stack.menu').href;
const markdown=route==='/'?'/agent-content/index.md':'/agent-content'+route.replace(/\/$/,'')+'.md';
const siteDescription='Tools and guidance for choosing, building with or reconsidering an application stack using your own agent.';
const missing=title==='Page not found';
const website={'@type':'WebSite',name:'Stack Menu',url:'https://stack.menu/',description:siteDescription};
const schema=title==='Contact' ? {'@context':'https://schema.org','@graph':[website,contact,{'@type':'ContactPage',name:'Contact · Stack Menu',url:canonical,description,mainEntity:{'@id':contact['@id']}}]} : {'@context':'https://schema.org',...website};
---
<!doctype html><html lang="en"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{title} · Stack Menu</title><meta name="description" content={description}/>
<meta name="robots" content={page==='utility' && title==='Page not found'?'noindex':'index,follow'}/>
<meta name="is-agentic-site-type" content="content"/>
{!missing && <link rel="canonical" href={canonical}/>}<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
<link rel="stylesheet" href={styles}/>{!missing && <link rel="alternate" type="text/markdown" href={markdown}/>}
<link rel="describedby" type="text/plain" href="/llms.txt"/><link rel="related" type="application/json" href="/selection-index.json"/>
<meta property="og:type" content="website"/><meta property="og:site_name" content="Stack Menu"/>
<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/>
<meta property="og:image" content="https://stack.menu/share-card.png"/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="Stack Menu: tools and guidance for your stack."/>
<meta property="og:image:type" content="image/png"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:image" content="https://stack.menu/share-card.png"/><meta name="twitter:image:alt" content="Stack Menu: tools and guidance for your stack."/>
<script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/>
{!missing && <script is:inline src="/analytics.js" defer></script>}
</head><body data-page={page}>
<a class="skip" href="#main">Skip to content</a>
<header><a class="brand" href="/">stack.menu</a><nav aria-label="Main"><a href="/agents/">For agents</a><a href="/choose/">Choose</a><a href="/rewrite/">Migrate</a></nav></header>
<Fragment set:html={body}/>
<footer><p><strong>Missed something?</strong><br/>Suggest a tool or correction at <a href={`mailto:${contact.contactPoint[0].email}`}>{contact.contactPoint[0].email}</a>.</p><nav aria-label="Footer"><a href="/about/">Sources &amp; coverage</a><a href="/contact/">Contact</a><a href="/privacy/">Privacy</a><a href="/llms.txt">llms.txt</a></nav></footer>
</body></html>
